# copy this file to /etc/systemd/system/

[Unit]
Description=Tatooine Monitor Service
After=multi-user.target

[Service]
Type=simple
Restart=always
ExecStart=/opt/tatooinePi/tatooine_monitor/venv-monitor/bin/python /opt/tatooinePi/tatooine_monitor/tatooine_monitor.py

[Install]
WantedBy=multi-user.target