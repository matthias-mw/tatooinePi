# Beispiel für die .env Datei mit den Zugangsdaten.
# Kopie nach ".env" anlegen (im selben Verzeichnis wie die .conf) und echte
# Werte eintragen. Die .env wird über .gitignore nicht in git eingecheckt.
# Beim Start hat eine bereits gesetzte Umgebungsvariable Vorrang vor der .env.

# InfluxDB V2 API Token (in der InfluxDB mit Schreibrechten auf das Bucket anlegen)
INFLUXDB_TOKEN=<InfluxDB-V2-API-Token>

# SMTP Zugangsdaten für den Alarm-Mail-Versand
SMTP_USERNAME=<SMTP-Benutzername>
SMTP_PASSWORD=<SMTP-Passwort>
